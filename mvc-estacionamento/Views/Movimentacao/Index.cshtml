@using mvc_estacionamento.Models
@model List<Movimentacao>

@{
    ViewBag.Title = "Index";
}

<h2>Tickets</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th scope="col">Cód.</th>
            <th scope="col">Modelo</th>
            <th scope="col">Placa</th>
            <th scope="col">Nº da Vaga</th>
            <th scope="col">Hora Entrada</th>
            <th scope="col">Hora Saída</th>
            <th scope="col">Valor Total</th>
            <th scope="col">Status</th>
            <th scope="col"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var movimentacao in Model)
        {
            <tr>
                <td>@movimentacao.id</td>
                <td>@movimentacao.modelo</td>
                <td>@movimentacao.placa</td>
                <td>@movimentacao.vaga_id</td>
                <td>@movimentacao.data_entrada</td>
                <td>@movimentacao.data_saida</td>
                <td>R$ @movimentacao.valor_pago</td>
                <td>@movimentacao.status</td>
            </tr>
        }
    </tbody>
</table>