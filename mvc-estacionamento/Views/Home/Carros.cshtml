@{
    ViewBag.Title = "Carros";
}

<h3>Cadastro de Carro</h3>

<form class="form-inline">
    <div class="form-group">
        <label for="exampleInputEmail2">Cliente</label>
        <input type="email" class="form-control" id="exampleInputEmail2" placeholder="Nome do Cliente">
    </div>
    <div class="form-group">
        <label for="exampleInputName2">Modelo</label>
        <input type="text" class="form-control" id="exampleInputName2" placeholder="Modelo do Carro">
    </div>
    <div class="form-group">
        <label for="exampleInputEmail2">Placa</label>
        <input type="email" class="form-control" id="exampleInputEmail2" placeholder="Placa do Carro">
    </div>
    <div class="form-group">
        <label for="exampleInputEmail2">Cor</label>
        <input type="email" class="form-control" id="exampleInputEmail2" placeholder="Cor do Carro">
    </div>
    <button type="submit" class="btn btn-success"><i class="bi bi-save-fill"></i> Cadastrar Carro</button>
</form>

<h3>Listagem dos Carros</h3>

<table class="table table-striped">
    <thead>
        <tr>
            <th scope="col">Cód.</th>
            <th scope="col">Cliente</th>
            <th scope="col">Modelo</th>
            <th scope="col">Placa</th>
            <th scope="col">Cor</th>
        </tr>
    </thead>
