@using mvc_estacionamento.Models
@model List<Veiculo>

@{
    ViewBag.Title = "Carros";
}
<br/>
<button type="submit" class="btn btn-success" data-toggle="modal" data-target="#modalAddCarro">
    <i class="bi bi-plus"></i> Cadastrar Veículo
</button>

<!-- Modal -->
<div class="modal fade" id="modalAddCarro" tabindex="-1" role="dialog" aria-labelledby="modalAddCarro">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Cadastrar Veículo</h4>
            </div>
            <div class="modal-body">
                @using (Html.BeginForm("Carros", "Home", FormMethod.Post))
                {
                <form class="form-inline">
                    <div class="form-group">
                        <label for="exampleInputName2">Modelo</label>
                        @Html.TextBox("modelo", null, new { @class = "form-control" })
                    </div>
                    <div class="form-group">
                        <label for="exampleInputEmail2">Placa</label>
                        @Html.TextBox("placa", null, new { @class = "form-control" })
                    </div>
                    <div class="form-group">
                        <label for="exampleInputEmail2">Cor</label>
                        @Html.TextBox("cor", null, new { @class = "form-control" })
                    </div>

                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-save-fill"></i> Cadastrar Carro
                    </button>
                </form>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-dismiss="modal"><i class="bi bi-x-lg"></i> Fechar</button>
            </div>
        </div>
    </div>
</div>



<h3>Listagem dos Carros</h3>

<table class="table table-striped">
    <thead>
        <tr>
            <th scope="col">Cód.</th>
            <th scope="col">Modelo</th>
            <th scope="col">Placa</th>
            <th scope="col">Cor</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var carro in Model)
        {
            <tr>
                <td>@carro.id</td>
                <td>@carro.modelo</td>
                <td>@carro.placa</td>
                <td>@carro.cor</td>
            </tr>
        }
    </tbody>
</table>
