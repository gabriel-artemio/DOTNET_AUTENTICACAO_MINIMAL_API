@{
    ViewBag.Title = "Vagas";
}

<h3>Cadastro de Vaga</h3>

<form class="form-inline">
    <div class="form-group">
        <label for="exampleInputEmail2">Nº Vaga</label>
        <input type="email" class="form-control" id="exampleInputEmail2" placeholder="Número da Vaga">
    </div>
    <button type="submit" class="btn btn-success"><i class="bi bi-save-fill"></i> Cadastrar Vaga</button>
</form>

<h3>Listagem de Vagas</h3>

<table class="table table-striped">
    <thead>
        <tr>
            <th scope="col">Cód.</th>
            <th scope="col">Nº. Vaga</th>
            <th scope="col">Status</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <th scope="row">1</th>
            <td>1</td>
            <td>Livre</td>
        </tr>
        <tr>
            <th scope="row">2</th>
            <td>2</td>
            <td>Livre</td>
        </tr>
        <tr>
            <th scope="row">3</th>
            <td>3</td>
            <td>Livre</td>
        </tr>
    </tbody>
</table>
